	measure SEC_2025_Annual_Orders = 338800000
		formatString: 0
		lineageTag: 4eb81eee-2555-4920-8add-3211f5935e0d

	measure SEC_2025_Active_Customers = 14000000
		formatString: 0
		lineageTag: 3e8ac93d-b4a1-451a-88e1-9a7a011e1894

	measure SEC_2025_Profit_Margin = 0.737
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 29ead141-0df6-4af3-abe6-4b17ad60ae4d

	measure Financial_Assumptions_HTML = ```
			
			-- 1. Calculate and format the dynamic annual visits
			VAR Dynamic_Sessions = FORMAT(DIVIDE([SEC_2025_Annual_Orders], [Conversion_Rate], 0) / 1000000000, "0.000") & "bn"
			
			RETURN
			"
			<div style='font-family: ""Segoe UI"", Helvetica, Arial, sans-serif; color: #2D3748; line-height: 1.5; width: 100%; padding: 15px;'>
			    
			    <!-- SECTION 1: SEC FILINGS ASSUMPTIONS -->
			    <div style='margin-bottom: 25px;'>
			        <h3 style='color: #1A365D; border-bottom: 2px solid #2B6CB0; padding-bottom: 6px; margin-top: 0; font-size: 18px;'>📋 Baseline Assumptions (SEC Filings)</h3>
			        <table style='width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px;'>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Annual Orders</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>338.8M</td>
			            </tr>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Active Users</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>14.0M</td>
			            </tr>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Annual Revenue</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>$3.742bn</td>
			            </tr>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Profit Margin</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>73.7%</td>
			            </tr>
			        </table>
			    </div>
			
			    <!-- SECTION 2: DERIVED / CALCULATED METRICS -->
			    <div>
			        <h3 style='color: #1A365D; border-bottom: 2px solid #4A5568; padding-bottom: 6px; margin-top: 0; font-size: 18px;'>🧮 Derived Operational Metrics</h3>
			        <p style='font-size: 12px; color: #718096; margin-top: 4px; margin-bottom: 10px; font-style: italic;'>Calculated from audited baseline values above</p>
			        <table style='width: 100%; border-collapse: collapse; font-size: 14px;'>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Annual Sessions</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px; color: #2B6CB0;'>" & Dynamic_Sessions & "</td>
			            </tr>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>Base Average Order Value (Base AOV)</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>$11.04</td>
			            </tr>
			            <tr style='border-bottom: 1px solid #E2E8F0;'>
			                <td style='padding: 8px 0; color: #4A5568; font-weight: 500;'>User Average Order Frequency (User AOF)*</td>
			                <td style='padding: 8px 0; text-align: right; font-family: Consolas, monospace; background-color: #F7FAFC; font-weight: bold; padding-right: 10px; border-radius: 4px;'>24.2</td>
			            </tr>
			        </table>
			        <p style='font-size: 11px; color: #718096; margin-top: 10px; font-style: italic; line-height: 1.3;'>*Represents a user's average annual orders</p>
			    </div>
			
			</div>
			"
			```
		lineageTag: 4d6c75ad-3c03-40d1-872f-eead8223e49a

