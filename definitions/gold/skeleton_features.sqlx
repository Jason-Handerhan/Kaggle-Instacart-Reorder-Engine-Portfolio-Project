config {
  type: "table",
  schema: "ml_model_feature_table",
  name: "skeleton_features",
  bigquery: {
    clusterBy: ["user_id"],
    additionalOptions: {
      expiration_timestamp: "TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)"
    }
  },
  description: "Create preliminary table. Join prelim features to candidate skeleton and forward-filling behavioral histories for user products not part of the historical anchor order.",
  columns: {
    user_id: column_descriptions.user_id,
    order_id: "Identifier of the anchor order: the user's order just before the label order. Features are computed as of this order.",
    order_number: "Order number of the anchor order within the user's history.",
    days_since_first_order: "Days from the user's first order to the anchor order.",
    candidate_product_id: column_descriptions.candidate_product_id,
    aisle_id: column_descriptions.aisle_id,
    department_id: column_descriptions.department_id,
    label_order_id: column_descriptions.label_order_id,
    label_order_number: column_descriptions.label_order_number,
    label_reordered: column_descriptions.label_reordered,
    label_order_dow: column_descriptions.label_order_dow,
    label_order_hour_of_day: column_descriptions.label_order_hour_of_day,
    label_days_since_prior_order: column_descriptions.label_days_since_prior_order,
    label_time_of_day: column_descriptions.label_time_of_day,
    label_days_since_first_order: column_descriptions.label_days_since_first_order,
    user_product_cumulative_purchases: "Number of orders in which the user bought the candidate product, as of the anchor order (carried forward from the last order that contained it).",
    user_product_avg_cart_position: "Average add_to_cart_order of the candidate product as of the anchor order (carried forward from the last order that contained it).",
    user_product_avg_relative_cart_position: "Average relative cart position (0 to 1) of the candidate product as of the anchor order (carried forward from the last order that contained it).",
    user_product_last_purchased_day: "Day, counted from the user's first order, of the product's latest purchase at or before the anchor order.",
    user_product_first_purchase_day: "Day, counted from the user's first order, of the user's first purchase of the product.",
    user_product_prev_purchase_day: "Day, counted from the user's first order, of the purchase before the latest one, carried forward from the last order containing the product. Null if bought only once.",
    user_product_last_purchased_order_number: "Order number of the product's latest purchase at or before the anchor order.",
    user_product_reorder_vs_total_reorders_ratio: "Share (0 to 1) of the user's reordered items that were this product, carried forward from the last order containing it.",
    user_product_cumulative_reorders: "Count of times the user reordered the candidate product, as of the anchor order (carried forward from the last order containing it).",
    user_product_last3order_streak: "Consecutive-order purchase streak of the product ending at the anchor order, capped at 3. 0 if the product is not in the anchor order.",
    user_product_cart_position_last_order: "add_to_cart_order of the candidate product in the anchor order. Null if the product was not in the anchor order.",
    user_product_same_dow_count_0: "Running count of the user's purchases of the product on day of week 0, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_1: "Running count of the user's purchases of the product on day of week 1, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_2: "Running count of the user's purchases of the product on day of week 2, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_3: "Running count of the user's purchases of the product on day of week 3, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_4: "Running count of the user's purchases of the product on day of week 4, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_5: "Running count of the user's purchases of the product on day of week 5, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_dow_count_6: "Running count of the user's purchases of the product on day of week 6, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_tod_count_morning: "Running count of the user's morning purchases of the product, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_tod_count_afternoon: "Running count of the user's afternoon purchases of the product, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_tod_count_evening: "Running count of the user's evening purchases of the product, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_product_same_tod_count_nighttime: "Running count of the user's nighttime purchases of the product, up to and including the last order containing the product at or before the anchor order (carried forward).",
    user_cumulative_aisle_products: "Count of product line items the user bought from the candidate's aisle up to the anchor order (carried forward from the last order containing the aisle).",
    user_aisle_last_purchased_day: "Day, counted from the user's first order, of the user's latest purchase from the candidate's aisle at or before the anchor order (carried forward from the last order containing the aisle).",
    user_cumulative_department_products: "Count of product line items the user bought from the candidate's department up to the anchor order (carried forward from the last order containing it).",
    user_avg_days_between_orders: "Average days between the user's orders up to the anchor order. 0 when undefined (anchor is the first order).",
    user_distinct_product_count: "Count of distinct products the user bought up to the anchor order. 0 if missing.",
    user_organic_affinity_ratio: "Share (0 to 1) of the user's products bought up to the anchor order that are organic. 0 if undefined.",
    user_avg_basket_size: "Average number of product line items per order for the user up to the anchor order. 0 if missing.",
    user_reorder_ratio: "Share (0 to 1) of the user's products bought up to the anchor order that were reorders. 0 if undefined.",
    user_cumulative_products: "Count of product line items the user bought across all orders up to the anchor order. 0 if missing.",
    user_cumulative_products_reordered: "Count of reordered product line items the user bought up to the anchor order. 0 if missing."
  }
}

SELECT
  cs.*,

  -- Foward fill last non-null value for products that were not part of an order
  LAST_VALUE(upf.user_product_cumulative_purchases IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_cumulative_purchases,
  LAST_VALUE(upf.user_product_avg_cart_position IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_avg_cart_position,
  LAST_VALUE(upf.user_product_avg_relative_cart_position IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_avg_relative_cart_position,
  LAST_VALUE(upf.user_product_last_purchased_day IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_last_purchased_day,
  LAST_VALUE(upf.user_product_first_purchase_day IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_first_purchase_day,
  LAST_VALUE(upf.user_product_prev_purchase_day IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_prev_purchase_day,
  LAST_VALUE(upf.user_product_last_purchased_order_number IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_last_purchased_order_number,
  LAST_VALUE(upf.user_product_reorder_vs_total_reorders_ratio IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_reorder_vs_total_reorders_ratio,
  LAST_VALUE(upf.user_product_cumulative_reorders IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_cumulative_reorders,

  --Fill user_product_last3order_streak nulls with 0 to indicate the streak is 0 when a product is not ordered
  COALESCE(upf.user_product_last3order_streak, 0) AS user_product_last3order_streak,

  --Leave user product add to cart order for their order prior to the label as null if it was not part of the order
  upf.add_to_cart_order AS user_product_cart_position_last_order,

  -- Forward fill wide dow counts
  LAST_VALUE(dow.user_product_same_dow_count_0 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_0,
  LAST_VALUE(dow.user_product_same_dow_count_1 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_1,
  LAST_VALUE(dow.user_product_same_dow_count_2 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_2,
  LAST_VALUE(dow.user_product_same_dow_count_3 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_3,
  LAST_VALUE(dow.user_product_same_dow_count_4 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_4,
  LAST_VALUE(dow.user_product_same_dow_count_5 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_5,
  LAST_VALUE(dow.user_product_same_dow_count_6 IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_dow_count_6,

  -- Forward fill wide tod counts
  LAST_VALUE(tod.user_product_same_tod_count_morning IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_tod_count_morning,
  LAST_VALUE(tod.user_product_same_tod_count_afternoon IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_tod_count_afternoon,
  LAST_VALUE(tod.user_product_same_tod_count_evening IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_tod_count_evening,
  LAST_VALUE(tod.user_product_same_tod_count_nighttime IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.candidate_product_id ORDER BY cs.order_number) AS user_product_same_tod_count_nighttime,

  -- Forward fill last non-null value for user department and user aisle preliminary features
  LAST_VALUE(a.user_cumulative_aisle_products IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.aisle_id ORDER BY cs.order_number) AS user_cumulative_aisle_products,
  LAST_VALUE(a.user_aisle_last_purchased_day IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.aisle_id ORDER BY cs.order_number) AS user_aisle_last_purchased_day,
  LAST_VALUE(d.user_cumulative_department_products IGNORE NULLS) OVER(PARTITION BY cs.user_id, cs.department_id ORDER BY cs.order_number) AS user_cumulative_department_products,

  -- Add preliminary order features
  COALESCE(o.user_avg_days_between_orders, 0) AS user_avg_days_between_orders,
  COALESCE(o.user_distinct_product_count, 0) AS user_distinct_product_count,
  COALESCE(o.user_organic_affinity_ratio, 0) AS user_organic_affinity_ratio,
  COALESCE(o.user_avg_basket_size, 0) AS user_avg_basket_size,
  COALESCE(o.user_reorder_ratio, 0) AS user_reorder_ratio,
  COALESCE(o.user_cumulative_products, 0) AS user_cumulative_products,
  COALESCE(o.user_cumulative_products_reordered, 0) AS user_cumulative_products_reordered

FROM ${ref("candidate_skeleton")} cs
LEFT JOIN ${ref("prelim_user_product_features")} upf
  ON cs.user_id = upf.user_id
  AND cs.order_id = upf.order_id
  AND cs.order_number = upf.order_number
  AND cs.candidate_product_id = upf.product_id
LEFT JOIN ${ref("prelim_user_order_dow_wide")} dow
  ON cs.user_id = dow.user_id
  AND cs.order_id = dow.order_id
  AND cs.order_number = dow.order_number
  AND cs.candidate_product_id = dow.product_id
LEFT JOIN ${ref("prelim_user_order_tod_wide")} tod
  ON cs.user_id = tod.user_id
  AND cs.order_id = tod.order_id
  AND cs.order_number = tod.order_number
  AND cs.candidate_product_id = tod.product_id
LEFT JOIN ${ref("prelim_user_aisle_features")} a
  ON cs.user_id = a.user_id
  AND cs.order_id = a.order_id
  AND cs.order_number = a.order_number
  AND cs.aisle_id = a.aisle_id
LEFT JOIN ${ref("prelim_user_department_features")} d
  ON cs.user_id = d.user_id
  AND cs.order_id = d.order_id
  AND cs.order_number = d.order_number
  AND cs.department_id = d.department_id
LEFT JOIN ${ref("prelim_user_order_features")} o
  ON cs.user_id = o.user_id
  AND cs.order_id = o.order_id
  AND cs.order_number = o.order_number