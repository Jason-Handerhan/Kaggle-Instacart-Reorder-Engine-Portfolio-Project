config {
  type: "table",
  schema: "ml_model_feature_table",
  name: "final_ml_features_table",
  description: "Gold Core: The final master modeling feature matrix used to train predictive ensemble classifiers.",
  columns: {
    user_id: column_descriptions.user_id,
    anchor_order_id: "Identifier of the anchor order: the user's order just before the label order. Features are computed as of this order.",
    anchor_order_number: "Order number of the anchor order within the user's history. Always greater than 4.",
    candidate_product_id: column_descriptions.candidate_product_id,
    department_id: column_descriptions.department_id,
    aisle_id: column_descriptions.aisle_id,
    anchor_days_since_first_order: "Days from the user's first order to the anchor order.",
    label_order_id: column_descriptions.label_order_id,
    label_order_number: column_descriptions.label_order_number,
    label_reordered: column_descriptions.label_reordered,
    label_order_dow: column_descriptions.label_order_dow,
    label_order_hour_of_day: column_descriptions.label_order_hour_of_day,
    label_days_since_prior_order: column_descriptions.label_days_since_prior_order,
    label_time_of_day: column_descriptions.label_time_of_day,
    label_days_since_first_order: column_descriptions.label_days_since_first_order,
    user_avg_days_between_orders: "Average days between the user's orders up to the anchor order. 0 when undefined.",
    user_distinct_product_count: "Count of distinct products the user bought up to the anchor order.",
    user_organic_affinity_ratio: "Share (0 to 1) of the user's products bought up to the anchor order that are organic.",
    user_avg_basket_size: "Average number of product line items per order for the user up to the anchor order.",
    user_reorder_ratio: "Share (0 to 1) of the user's products bought up to the anchor order that were reorders.",
    label_dow_user_product_same_dow_count: "Count of the user's purchases of the candidate product on the label order's day of week, as of the anchor order (running count carried forward from the product's last purchase). 0 if none.",
    label_tod_user_product_same_tod_count: "Count of the user's purchases of the candidate product in the label order's time of day, as of the anchor order (running count carried forward from the product's last purchase). 0 if none.",
    user_aisle_share: "Share (0 to 1) of the user's products bought up to the anchor order that came from the candidate's aisle. 0 if undefined.",
    user_deptartment_share: "Share (0 to 1) of the user's products bought up to the anchor order that came from the candidate's department. 0 if undefined.",
    user_product_cumulative_purchases: "Number of orders up to the anchor order in which the user bought the candidate product. 0 if missing.",
    user_product_avg_cart_position: "Average add_to_cart_order of the candidate product up to the anchor order. 0 if missing.",
    user_product_avg_relative_cart_position: "Average relative cart position (0 to 1, add_to_cart_order divided by items in the order) of the candidate product up to the anchor order. 0 if missing.",
    user_product_cart_position_last_order: "add_to_cart_order of the candidate product in the anchor order. Null if the product was not in the anchor order.",
    user_product_purchase_concentration: "Share (0 to 1) of the user's product line items up to the anchor order that were the candidate product. 0 if undefined.",
    user_product_reorder_concentration: "Share (0 to 1) of the user's reordered line items up to the anchor order that were the candidate product. 0 if undefined.",
    user_product_order_penetration_ratio: "Share (0 to 1) of the user's orders up to the anchor order that contained the candidate product. 0 if undefined.",
    user_product_consecutive_order_skips: "Number of orders between the product's latest purchase and the anchor order, counted as anchor order number minus the order number of that purchase. 0 if bought in the anchor order.",
    user_product_last3order_streak: "Consecutive-order purchase streak of the candidate product ending at the anchor order, capped at 3. 0 if not in the anchor order.",
    label_user_product_days_since_last_purchased: "Days from the product's latest purchase at or before the anchor order to the label order. 999 if undefined.",
    user_prod_avg_days_between_purchases: "Days from the user's first purchase of the product to the anchor order, divided by the number of purchases minus 1. 999 if undefined (bought once).",
    user_product_nearing_reorder_ratio: "Ratio of days since the product was last purchased (as of the label order) to the average days between its purchases. Above 1 means overdue. 999 if undefined.",
    days_since_last_ordered_vs_user_pace_ratio: "Ratio of days since the product was last purchased (as of the label order) to the user's average days between orders. 999 if undefined.",
    user_aisle_pacing_ratio: "Ratio of days since the user last purchased anything from the candidate's aisle (as of the label order) to the user's average days between orders. 999 if undefined.",
    user_product_day_of_week_affinity: "Share (0 to 1) of the user's purchases of the candidate product that fall on the label order's day of week. 0 if undefined.",
    user_product_time_of_day_affinity: "Share (0 to 1) of the user's purchases of the candidate product that fall in the label order's time of day. 0 if undefined."
  },
  assertions: {
    rowConditions: [
      /* 1. Complete Null Check for All Modeling Features (Excluding last cart position) */
      "user_id IS NOT NULL",
      "anchor_order_id IS NOT NULL",
      "anchor_order_number IS NOT NULL",
      "candidate_product_id IS NOT NULL",
      "department_id IS NOT NULL",
      "aisle_id IS NOT NULL",
      "anchor_days_since_first_order IS NOT NULL",
      "label_order_id IS NOT NULL",
      "label_order_number IS NOT NULL",
      "label_reordered IS NOT NULL",
      "label_order_dow IS NOT NULL",
      "label_order_hour_of_day IS NOT NULL",
      "label_days_since_prior_order IS NOT NULL",
      "label_time_of_day IS NOT NULL",
      "label_days_since_first_order IS NOT NULL",
      "user_avg_days_between_orders IS NOT NULL",
      "user_distinct_product_count IS NOT NULL",
      "user_organic_affinity_ratio IS NOT NULL",
      "user_avg_basket_size IS NOT NULL",
      "user_reorder_ratio IS NOT NULL",
      "label_dow_user_product_same_dow_count IS NOT NULL",
      "label_tod_user_product_same_tod_count IS NOT NULL",
      "user_aisle_share IS NOT NULL",
      "user_deptartment_share IS NOT NULL",
      "user_product_cumulative_purchases IS NOT NULL",
      "user_product_avg_cart_position IS NOT NULL",
      "user_product_avg_relative_cart_position IS NOT NULL",
      "user_product_purchase_concentration IS NOT NULL",
      "user_product_reorder_concentration IS NOT NULL",
      "user_product_order_penetration_ratio IS NOT NULL",
      "user_product_consecutive_order_skips IS NOT NULL",
      "user_product_last3order_streak IS NOT NULL",
      "label_user_product_days_since_last_purchased IS NOT NULL",
      "user_prod_avg_days_between_purchases IS NOT NULL",
      "user_product_nearing_reorder_ratio IS NOT NULL",
      "days_since_last_ordered_vs_user_pace_ratio IS NOT NULL",
      "user_aisle_pacing_ratio IS NOT NULL",
      "user_product_day_of_week_affinity IS NOT NULL",
      "user_product_time_of_day_affinity IS NOT NULL",

      /* 2. Check for anchor and label order sequence logic */
      "anchor_order_number = (label_order_number - 1)",
      
      /* 3. Confirm cold-start filter is enforced */
      "anchor_order_number > 4",
      
      /* 4. Validate target label and streak bounds */
      "label_reordered IN (0, 1)",
      "user_product_last3order_streak BETWEEN 0 AND 3",
      
      /* 5. Validate calendar and time bounds */
      "label_order_dow BETWEEN 0 AND 6",
      "label_order_hour_of_day BETWEEN 0 AND 23",
      
      /* 6. Validate affinity percentages/ratios fall between 0 and 1 */
      "user_organic_affinity_ratio BETWEEN 0 AND 1",
      "user_reorder_ratio BETWEEN 0 AND 1",
      "user_product_day_of_week_affinity BETWEEN 0 AND 1",
      "user_product_time_of_day_affinity BETWEEN 0 AND 1"
    ]
  }
}

WITH temp_ml_features AS (
  SELECT
  user_id,
  order_id AS anchor_order_id,
  order_number AS anchor_order_number,
  candidate_product_id,
  department_id,
  aisle_id,
  days_since_first_order AS anchor_days_since_first_order,
  label_order_id,
  label_order_number,
  label_reordered,
  label_order_dow,
  label_order_hour_of_day,
  label_days_since_prior_order,
  label_time_of_day,
  label_days_since_first_order,

  -- User Order Features
  user_avg_days_between_orders,
  user_distinct_product_count,
  user_organic_affinity_ratio,
  user_avg_basket_size,
  user_reorder_ratio,

  -- Cumulative product purchase on same day of week as label context dow
  CASE
      WHEN label_order_dow = 0 THEN user_product_same_dow_count_0
      WHEN label_order_dow = 1 THEN user_product_same_dow_count_1
      WHEN label_order_dow = 2 THEN user_product_same_dow_count_2
      WHEN label_order_dow = 3 THEN user_product_same_dow_count_3
      WHEN label_order_dow = 4 THEN user_product_same_dow_count_4
      WHEN label_order_dow = 5 THEN user_product_same_dow_count_5
      WHEN label_order_dow = 6 THEN user_product_same_dow_count_6
      ELSE 0
  END AS label_dow_user_product_same_dow_count,

  -- Cumulative product purchase on same time of day as label context tod
  CASE
      WHEN label_time_of_day = 'morning' THEN user_product_same_tod_count_morning
      WHEN label_time_of_day = 'afternoon' THEN user_product_same_tod_count_afternoon
      WHEN label_time_of_day = 'evening' THEN user_product_same_tod_count_evening
      WHEN label_time_of_day = 'nighttime' THEN user_product_same_tod_count_nighttime
      ELSE 0
    END AS label_tod_user_product_same_tod_count,

  -- User Category Features
  COALESCE(SAFE_DIVIDE(hist.user_cumulative_aisle_products, hist.user_cumulative_products), 0) AS user_aisle_share,
  COALESCE(SAFE_DIVIDE(hist.user_cumulative_department_products, hist.user_cumulative_products), 0) AS user_deptartment_share,

  -- User Product Features
  COALESCE(hist.user_product_cumulative_purchases, 0) AS user_product_cumulative_purchases,
  COALESCE(hist.user_product_avg_cart_position, 0.0) AS user_product_avg_cart_position,
  COALESCE(hist.user_product_avg_relative_cart_position, 0.0) AS user_product_avg_relative_cart_position,
  user_product_cart_position_last_order AS user_product_cart_position_last_order,

  -- Product Concentrations
  COALESCE(SAFE_DIVIDE(hist.user_product_cumulative_purchases, hist.user_cumulative_products), 0) AS user_product_purchase_concentration,
  COALESCE(SAFE_DIVIDE(hist.user_product_cumulative_reorders, hist.user_cumulative_products_reordered), 0) AS user_product_reorder_concentration,

  -- Structural Ratios
  COALESCE(SAFE_DIVIDE(hist.user_product_cumulative_purchases, hist.order_number), 0) AS user_product_order_penetration_ratio,
  (hist.order_number - hist.user_product_last_purchased_order_number) AS user_product_consecutive_order_skips,
  hist.user_product_last3order_streak,

  -- Recency & Pacings
  COALESCE(hist.label_days_since_first_order - hist.user_product_last_purchased_day, 999) AS label_user_product_days_since_last_purchased,
  COALESCE(SAFE_DIVIDE(hist.days_since_first_order - hist.user_product_first_purchase_day, hist.user_product_cumulative_purchases - 1), 999) AS user_prod_avg_days_between_purchases,
  COALESCE(SAFE_DIVIDE(hist.label_days_since_first_order - hist.user_aisle_last_purchased_day, hist.user_avg_days_between_orders), 999) AS user_aisle_pacing_ratio

  FROM ${ref("skeleton_features")} hist
  WHERE hist.order_number > 4
)

SELECT
  temp_ml.*,
  COALESCE(SAFE_DIVIDE(temp_ml.label_user_product_days_since_last_purchased, temp_ml.user_prod_avg_days_between_purchases), 999) AS user_product_nearing_reorder_ratio,
  COALESCE(SAFE_DIVIDE(temp_ml.label_user_product_days_since_last_purchased, temp_ml.user_avg_days_between_orders), 999) AS days_since_last_ordered_vs_user_pace_ratio,
  COALESCE(SAFE_DIVIDE(temp_ml.label_dow_user_product_same_dow_count, temp_ml.user_product_cumulative_purchases), 0) AS user_product_day_of_week_affinity,
  COALESCE(SAFE_DIVIDE(temp_ml.label_tod_user_product_same_tod_count, temp_ml.user_product_cumulative_purchases), 0) AS user_product_time_of_day_affinity
FROM temp_ml_features temp_ml