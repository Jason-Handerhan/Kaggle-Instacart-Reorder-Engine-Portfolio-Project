config {
  type: "table",
  schema: "building_blocks",
  name: "prelim_user_order_tod_wide",
  bigquery: { clusterBy: ["user_id"] },
  description: "Create wide table of historical product purchases indicating the time of day for each purchase.",
  columns: {
    user_id: column_descriptions.user_id,
    product_id: column_descriptions.product_id,
    order_id: column_descriptions.order_id,
    order_number: column_descriptions.order_number,
    user_product_same_tod_count_morning: "Running count of the user's purchases of this product in the morning (05-11h) up to this order. Equals 0 when this order was not placed in the morning.",
    user_product_same_tod_count_afternoon: "Running count of the user's purchases of this product in the afternoon (12-16h) up to this order. Equals 0 when this order was not placed in the afternoon.",
    user_product_same_tod_count_evening: "Running count of the user's purchases of this product in the evening (17-21h) up to this order. Equals 0 when this order was not placed in the evening.",
    user_product_same_tod_count_nighttime: "Running count of the user's purchases of this product at night (22-04h) up to this order. Equals 0 when this order was not placed at night."
  }
}

SELECT
  user_id,
  product_id,
  order_id,
  order_number,
  SUM(CASE WHEN time_of_day = 'morning' THEN user_product_same_tod_count ELSE 0 END) as user_product_same_tod_count_morning,
  SUM(CASE WHEN time_of_day = 'afternoon' THEN user_product_same_tod_count ELSE 0 END) as user_product_same_tod_count_afternoon,
  SUM(CASE WHEN time_of_day = 'evening' THEN user_product_same_tod_count ELSE 0 END) as user_product_same_tod_count_evening,
  SUM(CASE WHEN time_of_day = 'nighttime' THEN user_product_same_tod_count ELSE 0 END) as user_product_same_tod_count_nighttime
FROM ${ref("prelim_user_product_features")}
GROUP BY user_id, product_id, order_id, order_number