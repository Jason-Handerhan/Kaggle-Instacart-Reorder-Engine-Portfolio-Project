config {
  type: "table",
  schema: "building_blocks",
  name: "base_analytical_table",
  bigquery: {
    clusterBy: ["user_id"]
  },
  description: "Base analytical table that compiles cleaned orders, products, departments, and aisles to use for generating features.",
  columns: {
    order_id: column_descriptions.order_id,
    user_id: column_descriptions.user_id,
    order_number: column_descriptions.order_number,
    order_dow: column_descriptions.order_dow,
    order_hour_of_day: column_descriptions.order_hour_of_day,
    time_of_day: column_descriptions.time_of_day,
    days_since_prior_order: column_descriptions.days_since_prior_order,
    days_since_first_order: column_descriptions.days_since_first_order,
    eval_set: column_descriptions.eval_set,
    product_id: column_descriptions.product_id,
    add_to_cart_order: column_descriptions.add_to_cart_order,
    reordered: column_descriptions.reordered,
    aisle_id: column_descriptions.aisle_id,
    aisle: column_descriptions.aisle,
    department_id: column_descriptions.department_id,
    department: column_descriptions.department,
    product_name: column_descriptions.product_name,
    is_organic: column_descriptions.is_organic
  }
}

SELECT
  o.*,
  op.product_id,
  op.add_to_cart_order,
  op.reordered,
  p.aisle_id,
  a.aisle,
  p.department_id,
  d.department,
  p.product_name,
  p.is_organic
FROM ${ref("cleansed_orders")} o
INNER JOIN ${ref("order_products_cleansed")} op ON o.order_id = op.order_id
INNER JOIN ${ref("cleansed_products")} p ON op.product_id = p.product_id
INNER JOIN ${ref("departments")} d ON p.department_id = d.department_id
INNER JOIN ${ref("aisles")} a ON p.aisle_id = a.aisle_id