config {
  type: "table",
  schema: "instacart",
  name: "cleansed_products",
  description: "Product dimension records with flag tracking if product is organic based on text lookup",
  columns: {
    product_id: column_descriptions.product_id,
    aisle_id: column_descriptions.aisle_id,
    department_id: column_descriptions.department_id,
    product_name: column_descriptions.product_name,
    is_organic: column_descriptions.is_organic
  }
}

SELECT
  CAST(product_id AS INT64) AS product_id,
  CAST(aisle_id AS INT64) AS aisle_id,
  CAST(department_id AS INT64) AS department_id,
  product_name,
  CASE
    WHEN REGEXP_CONTAINS(LOWER(product_name), r'(^|[^a-z])organic([^a-z]|$)') THEN 1
    ELSE 0
  END AS is_organic
FROM ${ref("products")}